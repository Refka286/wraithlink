POSTGRES_USER=wraithlink
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wraithlink

JWT_SECRET=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=30

EVIDENCE_STORAGE_PATH=/data/evidence

ANTHROPIC_API_KEY=

# Fernet key for the credentials vault - generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# deliberately separate from POSTGRES_PASSWORD/JWT_SECRET so a leaked DB
# connection string alone can never decrypt vaulted AD credentials
CREDENTIALS_ENCRYPTION_KEY=

# override only if the default ports are already taken on your machine
# BACKEND_HOST_PORT=8000
# FRONTEND_HOST_PORT=5173
